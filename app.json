{
  "expo": {
    "name": "SweetCasa",
    "slug": "SweetCasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sweetcasa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAIePGfP4Vpa4UCC_htp3MqD2G18TUb4KI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SweetCasa uses your location to help you set the exact location of your property listing."
      }
    },
    "android": {
  "package": "com.ndeh_paul.SweetCasa",
  "softwareKeyboardLayoutMode": "resize",
  "config": {
    "googleMaps": {
      "apiKey": "AIzaSyAIePGfP4Vpa4UCC_htp3MqD2G18TUb4KI"
    }
  }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SweetCasa uses your location to help you set the exact location of your property listing."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e1f8320-78db-4659-84c7-8027407939e8"
      }
    }
  }
}
