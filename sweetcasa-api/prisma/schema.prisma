generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                @id @default(autoincrement())
  name                String             @db.VarChar(100)
  companyName         String?            @map("company_name") @db.VarChar(100)
  email               String             @unique @db.VarChar(255)
  password            String             @db.VarChar(255)
  phone               BigInt?
  role                String             @default("BUYER") @db.VarChar(50)
  /// 'Active' | 'Suspended'
  status              String             @default("Active") @db.VarChar(20)
  suspendedAt         DateTime?          @map("suspended_at")
  suspendedBy         Int?               @map("suspended_by")
  suspensionReason    String?            @map("suspension_reason")
  country             String?            @db.VarChar(50)
  region              String?            @db.VarChar(50)
  city                String?            @db.VarChar(50)
  street              String?
  nationalIdUrl       String?            @map("national_id_url")
  nationalIdPublicId  String?            @map("national_id_public_id") @db.VarChar(255)
  createdAt           DateTime?          @default(now()) @map("created_at")
  casaMatchHistory    CasaMatchHistory[]
  aiConversations     AiConversation[]
  listings            Listing[]
  savedListings       SavedListing[]
  listingReviews      ListingReview[]
  reports             Report[]
  buyerConversations  Conversation[]     @relation("BuyerConversations")
  sellerConversations Conversation[]     @relation("SellerConversations")
  sentMessages        Message[]          @relation("SentMessages")
  documents           Document[]

  @@map("users")
}

model Report {
  id           Int       @id @default(autoincrement())
  userId       Int?      @map("user_id")
  category     String    @db.VarChar(50)
  subject      String    @db.VarChar(255)
  description  String
  followUp     Boolean   @default(false)
  evidenceUrls Json?     @map("evidence_urls")
  status       String    @default("Pending") @db.VarChar(30)
  createdAt    DateTime? @default(now()) @map("created_at")
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Listing {
  id                   Int            @id @default(autoincrement())
  ownerId              Int?           @map("owner_id")
  title                String         @db.VarChar(120)
  price                Decimal        @db.Decimal(12, 2)
  type                 String         @db.VarChar(50)
  status               String         @default("Pending")
  state                String         @default("Available") @db.VarChar(20)
  country              String         @default("Cameroon") @db.VarChar(50)
  city                 String         @db.VarChar(50)
  region               String         @db.VarChar(50)
  neighborhood         String?        @db.VarChar(100)
  description          String
  bedrooms             Int            @default(0)
  bathrooms            Int            @default(0)
  toilets              Int            @default(0)
  parlors              Int            @default(0)
  kitchens             Int            @default(0)
  areaSqm              Decimal?       @map("area_sqm") @db.Decimal(10, 2)
  paymentFrequency     String?        @map("payment_frequency") @db.VarChar(20)
  visitHours           String?        @map("visit_hours") @db.VarChar(120)
  facilities           Json?
  nearbySchoolName     String?        @map("nearby_school_name") @db.VarChar(150)
  nearbyBankName       String?        @map("nearby_bank_name") @db.VarChar(150)
  nearbyRestaurantName String?        @map("nearby_restaurant_name") @db.VarChar(150)
  nearbyMarketName     String?        @map("nearby_market_name") @db.VarChar(150)
  nearbyClinicName     String?        @map("nearby_clinic_name") @db.VarChar(150)
  floorPlanUrl         String?        @map("floor_plan_url")
  legalDocumentUrls    Json?          @map("legal_document_urls")
  approvedAt           DateTime?      @map("approved_at")
  rejectionNote        String?        @map("rejection_note")
  createdAt            DateTime?      @default(now()) @map("created_at")
  owner                User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images               ListingImage[]
  videos               ListingVideo[]
  savedListings        SavedListing[]
  conversations        Conversation[]
  documents            Document[]

  @@map("listings")
}

model ListingImage {
  id                 Int       @id @default(autoincrement())
  listingId          Int?      @map("listing_id")
  imageUrl           String    @map("image_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id") @db.VarChar(255)
  isPrimary          Boolean?  @default(false) @map("is_primary")
  sortOrder          Int?      @default(0) @map("sort_order")
  uploaded           DateTime? @default(now())
  listing            Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listings_images")
}

model ListingVideo {
  id                 Int       @id @default(autoincrement())
  listingId          Int?      @map("listing_id")
  videoUrl           String    @map("video_url")
  thumbnailUrl       String?   @map("thumbnail_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id") @db.VarChar(255)
  durationSecond     Int?      @map("duration_second")
  fileSize           BigInt?   @map("file_size")
  uploaded           DateTime? @default(now())
  listing            Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listings_videos")
}

model SavedListing {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  listingId Int       @map("listing_id")
  savedAt   DateTime? @default(now()) @map("saved_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId], map: "unique_user_saved_listing")
  @@map("saved_listings")
}

model CasaMatchHistory {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  message   String?
  aiReply   String?   @map("ai_reply")
  createdAt DateTime? @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("casamatch_history")
}

// ─── AI Chat (CasaMatch conversational agent) ─────────────────────────────────

model AiConversation {
  id        Int             @id @default(autoincrement())
  userId    Int             @map("user_id")
  title     String          @default("New Chat") @db.VarChar(200)
  language  String          @default("en") @db.VarChar(10)
  createdAt DateTime?       @default(now()) @map("created_at")
  updatedAt DateTime?       @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@map("ai_conversations")
}

model AiChatMessage {
  id              Int            @id @default(autoincrement())
  conversationId  Int            @map("conversation_id")
  /// 'user' | 'assistant'
  role            String         @db.VarChar(20)
  content         String
  imageUrl        String?        @map("image_url")
  audioUrl        String?        @map("audio_url")
  audioTranscript String?        @map("audio_transcript")
  /// JSON array of MatchResult objects when the AI returned listings
  listingResults  Json?          @map("listing_results")
  createdAt       DateTime?      @default(now()) @map("created_at")
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
}

// ─── Staff invites (admin → staff onboarding) ─────────────────────────────────
model StaffInvite {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(255)
  /// role granted once accepted — currently always 'STAFF'
  role       String    @default("STAFF") @db.VarChar(20)
  token      String    @unique
  /// 'Pending' | 'Accepted' | 'Revoked' | 'Expired'
  status     String    @default("Pending") @db.VarChar(20)
  invitedBy  Int?       @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime? @default(now()) @map("created_at")

  @@map("staff_invites")
}

// ─── Audit log — full history of admin/staff actions in the Trust Desk ───────
model AuditLog {
  id          Int       @id @default(autoincrement())
  actorId     Int?      @map("actor_id")
  actorName   String?   @map("actor_name")
  actorRole   String?   @map("actor_role") @db.VarChar(20)
  /// e.g. 'LISTING_APPROVED', 'DOCUMENT_REJECTED', 'USER_SUSPENDED', 'STAFF_INVITED'
  action      String    @db.VarChar(60)
  entityType  String?   @map("entity_type") @db.VarChar(40)
  entityId    Int?      @map("entity_id")
  entityLabel String?   @map("entity_label")
  metadata    String?
  createdAt   DateTime? @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─── Document Vault ────────────────────────────────────────────────────────────
// Real, reviewable documents — replaces the loose `legalDocumentUrls` JSON field.
// `legalDocumentUrls` is left in place on Listing for backward compatibility with
// listings created before this table existed; new uploads should create Document rows.

model Document {
  id                 Int       @id @default(autoincrement())
  listingId          Int?      @map("listing_id")
  userId             Int?      @map("user_id")
  /// 'LEGAL_DOCUMENT' | 'FLOOR_PLAN' | 'NATIONAL_ID' | 'OTHER'
  type               String    @db.VarChar(50)
  fileName           String?   @map("file_name") @db.VarChar(255)
  url                String
  cloudinaryPublicId String?   @map("cloudinary_public_id") @db.VarChar(255)
  /// 'Pending' | 'Verified' | 'Rejected'
  status             String    @default("Pending") @db.VarChar(30)
  reviewedBy         Int?      @map("reviewed_by")
  reviewNote         String?   @map("review_note")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime? @default(now()) @map("created_at")
  listing            Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("documents")
}

// ─── Existing buyer–seller messaging ──────────────────────────────────────────

model ListingReview {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  userRole  String    @map("user_role") @db.VarChar(50)
  review    String
  createdAt DateTime? @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("listing_reviews")
}

model Conversation {
  id          Int       @id @default(autoincrement())
  listingId   Int?      @map("listing_id")
  buyerId     Int       @map("buyer_id")
  sellerId    Int       @map("seller_id")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  buyer       User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  listing     Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@unique([listingId, buyerId, sellerId])
  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderId       Int          @map("sender_id")
  text           String
  seen           Boolean      @default(false)
  createdAt      DateTime?    @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}
