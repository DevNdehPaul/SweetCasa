generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(100)
  companyName      String?            @map("company_name") @db.VarChar(100)
  email            String             @unique @db.VarChar(255)
  password         String             @db.VarChar(255)
  phone            BigInt?
  role             String             @default("BUYER") @db.VarChar(50)
  country          String?            @db.VarChar(50)
  region           String?            @db.VarChar(50)
  city             String?            @db.VarChar(50)
  street           String?
  createdAt        DateTime?          @default(now()) @map("created_at")
  casaMatchHistory CasaMatchHistory[]
  listings         Listing[]
  savedListings    SavedListing[]
  listingReviews   ListingReview[]
  reports          Report[]

  @@map("users")
}
model Report {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  category    String    @db.VarChar(50)
  subject     String    @db.VarChar(255)
  description String
  followUp    Boolean   @default(false)
  evidenceUrls Json?    @map("evidence_urls")
  status      String    @default("Pending") @db.VarChar(30)
  createdAt   DateTime? @default(now()) @map("created_at")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reports")
}
model Listing {
  id                  Int            @id @default(autoincrement())
  ownerId             Int?           @map("owner_id")
  title               String         @db.VarChar(120)
  price               Decimal        @db.Decimal(12, 2)
  type                String         @db.VarChar(50)
  status              String         @default("Pending")
  state               String         @default("Available") @db.VarChar(20)
  country             String         @default("Cameroon") @db.VarChar(50)
  city                String         @db.VarChar(50)
  region              String         @db.VarChar(50)
  neighborhood        String?        @db.VarChar(100)
  description         String
  bedrooms            Int            @default(0)
  bathrooms           Int            @default(0)
  toilets             Int            @default(0)
  parlors             Int            @default(0)
  kitchens            Int            @default(0)
  areaSqm             Decimal?       @map("area_sqm") @db.Decimal(10, 2)
  paymentFrequency    String?        @map("payment_frequency") @db.VarChar(20)
  visitHours          String?        @map("visit_hours") @db.VarChar(120)
  facilities          Json?
  // Nearby facility name fields (optional, user-provided)
  nearbySchoolName    String?        @map("nearby_school_name") @db.VarChar(150)
  nearbyBankName      String?        @map("nearby_bank_name") @db.VarChar(150)
  nearbyRestaurantName String?       @map("nearby_restaurant_name") @db.VarChar(150)
  nearbyMarketName    String?        @map("nearby_market_name") @db.VarChar(150)
  nearbyClinicName    String?        @map("nearby_clinic_name") @db.VarChar(150)
  floorPlanUrl        String?        @map("floor_plan_url")
  legalDocumentUrls   Json?          @map("legal_document_urls")
  approvedAt          DateTime?      @map("approved_at")
  createdAt           DateTime?      @default(now()) @map("created_at")
  owner               User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images              ListingImage[]
  videos              ListingVideo[]
  savedListings       SavedListing[]

  @@map("listings")
}

model ListingImage {
  id                 Int       @id @default(autoincrement())
  listingId          Int?      @map("listing_id")
  imageUrl           String    @map("image_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id") @db.VarChar(255)
  isPrimary          Boolean?  @default(false) @map("is_primary")
  sortOrder          Int?      @default(0) @map("sort_order")
  uploaded           DateTime? @default(now())
  listing            Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listings_images")
}

model ListingVideo {
  id                 Int       @id @default(autoincrement())
  listingId          Int?      @map("listing_id")
  videoUrl           String    @map("video_url")
  thumbnailUrl       String?   @map("thumbnail_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id") @db.VarChar(255)
  durationSecond     Int?      @map("duration_second")
  fileSize           BigInt?   @map("file_size")
  uploaded           DateTime? @default(now())
  listing            Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listings_videos")
}

model SavedListing {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  listingId Int       @map("listing_id")
  savedAt   DateTime? @default(now()) @map("saved_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId], map: "unique_user_saved_listing")
  @@map("saved_listings")
}

model CasaMatchHistory {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  message   String?
  aiReply   String?   @map("ai_reply")
  createdAt DateTime? @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("casamatch_history")
}

model ListingReview {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  userRole  String    @map("user_role") @db.VarChar(50)
  review    String
  createdAt DateTime? @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("listing_reviews")
}
